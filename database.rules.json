{
  "rules": {
    ".read": false,
    ".write": false,

    "members": {
      "$coupleId": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || data.child(auth.uid).exists())",
        ".validate": "newData.child(auth.uid).exists()",
        "$uid": { ".validate": "newData.val() === true" }
      }
    },

    "presence": {
      "$coupleId": {
        ".read": "auth != null && root.child('members').child($coupleId).child(auth.uid).exists()",
        "$userId": {
          ".write": "auth != null && auth.uid === $userId && root.child('members').child($coupleId).child(auth.uid).exists()"
        }
      }
    },

    "mood": {
      "$coupleId": {
        ".read": "auth != null && root.child('members').child($coupleId).child(auth.uid).exists()",
        "$userId": {
          ".write": "auth != null && auth.uid === $userId && root.child('members').child($coupleId).child(auth.uid).exists()"
        }
      }
    },

    "touch": {
      "$coupleId": {
        ".read": "auth != null && root.child('members').child($coupleId).child(auth.uid).exists()",
        "$userId": {
          ".write": "auth != null && auth.uid === $userId && root.child('members').child($coupleId).child(auth.uid).exists()"
        }
      }
    },

    "canvas": {
      "$coupleId": {
        ".read": "auth != null && root.child('members').child($coupleId).child(auth.uid).exists()",
        ".write": "auth != null && root.child('members').child($coupleId).child(auth.uid).exists()"
      }
    }
  }
}
