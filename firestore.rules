rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isCoupleMember(coupleId) {
      let couple = get(/databases/$(database)/documents/couples/$(coupleId)).data;
      return signedIn()
          && (couple.userAId == request.auth.uid || couple.userBId == request.auth.uid);
    }

    // Profiles: any signed-in user can read (partner lookup); only the owner writes,
    // except pairing, which may set coupleId on the partner's doc.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        request.auth.uid == uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId'])
          && exists(/databases/$(database)/documents/couples/$(request.resource.data.coupleId))
          && isCoupleMember(request.resource.data.coupleId)
          && (get(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.userAId == uid
              || get(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.userBId == uid)
        )
      );
    }

    match /couples/{coupleId} {
      allow create: if signedIn()
        && (request.resource.data.userAId == request.auth.uid
            || request.resource.data.userBId == request.auth.uid);
      allow read, update: if isCoupleMember(coupleId);
    }

    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn();
    }

    match /moods/{coupleId}/{document=**} {
      allow read, write: if isCoupleMember(coupleId);
    }
    match /memories/{coupleId}/{document=**} {
      allow read, write: if isCoupleMember(coupleId);
    }
    match /milestones/{coupleId}/{document=**} {
      allow read, write: if isCoupleMember(coupleId);
    }
    match /notifications/{coupleId}/{document=**} {
      allow read, write: if isCoupleMember(coupleId);
    }
  }
}
